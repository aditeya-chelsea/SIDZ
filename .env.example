# ==============================================================================
# SIDZ OSINT - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure as needed:
#   cp .env.example .env
# ==============================================================================

# Server Network Binding
HOST=127.0.0.1
PORT=8000

# Concurrency
# Maximum simultaneous background intelligence workers
MAX_CONCURRENT_SCANS=4

# ------------------------------------------------------------------------------
# Optional Intelligence Enrichment Keys
# ------------------------------------------------------------------------------
# SIDZ works 100% locally out-of-the-box using legitimate public OSINT sources.
# The keys below are strictly optional for authorized third-party enrichment:

# Have I Been Pwned (HIBP) API v3 key (for authorized email breach exposure audits)
HIBP_API_KEY=

# Shodan API Key (for external infrastructure and exposed host telemetry)
SHODAN_API_KEY=

# VirusTotal API Key (for passive domain & IP reputation scoring)
VIRUSTOTAL_API_KEY=
